# Kipepeo Market — Environment Variables
# Application Environment
NODE_ENV=production
# Session Security (REQUIRED - use a long random string)
SESSION_SECRET=replace_with_a_long_random_secret_32_characters_minimum
# Database Path (Optional - defaults to database/kipepeo.db)
DATABASE_PATH=/var/data/kipepeo.db
# Admin Account (Optional - for creating admin on first run)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password